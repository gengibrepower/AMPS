MYSQL_ROOT_PASSWORD=PUT_YOUR_PASSWORD_HERE
MYSQL_DATABASE=parking_system
MYSQL_HOST=localhost
MYSQL_PORT=3307
MYSQL_USER=root
MYSQL_PASSWORD=PUT_YOUR_PASSWORD_HERE
AUTH_JWT_SECRET=PUT_YOUR_SECRET_HERE
PORT=3001
CORS_ORIGIN=http://localhost:5173
MERLIAN_URL=http://localhost:3000
AUTH_TOKEN_TTL=8h

# --- Segurança / TLS (Projeto Final) ---
# Quando true, a API conecta no MySQL por TLS (o compose já sobe o MySQL com
# --require-secure-transport=ON). O script `dev` da API já exporta MYSQL_SSL=true,
# NODE_EXTRA_CA_CERTS (CA própria) e MERLIAN_URL=https://localhost:8444.
MYSQL_SSL=true
# O Caddy (infra/proxy) termina TLS: API em https://localhost:8443 e Merlian em :8444.
# Gere os certificados antes: bash infra/tls/gerar-certs.sh
# Front (packages/web/.env.local): VITE_API_URL=https://localhost:8443

# Chave da criptografia em repouso do CPF (AES-256-GCM). Gere com:
#   openssl rand -base64 32
# Em producao e OBRIGATORIA; sem ela, usa-se uma chave de desenvolvimento.
AES_KEY=
